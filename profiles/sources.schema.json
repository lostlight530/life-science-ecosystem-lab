{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lostlight530/life-science-ecosystem-lab/raw/main/profiles/sources.schema.json",
  "title": "RS12 approved GitHub source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "ref", "approved", "required", "trust", "include", "exclude", "max_bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "ref": {"type": "string", "minLength": 1},
          "approved": {"const": true},
          "required": {"type": "boolean"},
          "trust": {"enum": ["primary", "maintainer", "community"]},
          "include": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exclude": {"type": "array", "items": {"type": "string"}},
          "max_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
