  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE",
  "name": "Life Science Protein File Audit",
  "version": "0.4.0",
  "description": "Offline, deterministic bioinformatics command-line analysis of amino-acid composition and ambiguous residues in protein FASTA files, and observed first-model C-alpha residue inventory in PDB coordinate files. Reports source SHA-256 and bounded quality warnings. Does not infer protein structures or validate molecular geometry.",
  "applicationCategory": "Bioinformatics protein sequence and coordinate file quality control",
  "url": "https://github.com/lostlight530/life-science-ecosystem-lab/tree/main/bio_tool",
  "codeRepository": "https://github.com/lostlight530/life-science-ecosystem-lab",
  "license": "https://spdx.org/licenses/MIT",
  "programmingLanguage": "Python 3",
  "softwareRequirements": "Python 3.11+, no required runtime dependencies",
  "creator": {
    "@type": "Person",
    "name": "Xuanyi Jiang",
    "identifier": "https://orcid.org/0009-0001-3617-0832"
  },
  "featureList": [
    "FASTA protein sequence composition",
    "ambiguous residue reporting",
    "PDB first-model observed C-alpha residue counts",
    "input-file SHA-256",
    "machine-readable JSON quality reports"
  ],
  "documentation": "https://github.com/lostlight530/life-science-ecosystem-lab/blob/main/bio_tool/README.md"
}
