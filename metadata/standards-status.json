{
  "schema_version": "1.0.0",
  "software_version": "0.4.0",
  "workflow": ".github/workflows/life-science-knowledge.yml",
  "tool": "evidence/cli.py",
  "requirements": {
    "Workflow RO-Crate 1.1": "REQUIRED_STRUCTURAL_PREFLIGHT",
    "Workflow Testing RO-Crate 0.2": "REQUIRED_STRUCTURAL_PREFLIGHT",
    "CWL 1.2 portable workflow": "CI_EXECUTABLE",
    "Bioschemas ComputationalWorkflow 1.0": "DECLARED_NOT_EXTERNALLY_CERTIFIED",
    "Bioschemas ComputationalTool 1.0": "DECLARED_NOT_EXTERNALLY_CERTIFIED",
    "Bioschemas FormalParameter 1.0": "DECLARED_NOT_EXTERNALLY_CERTIFIED",
    "CFF 1.2.0": "DECLARED_TESTED",
    "SPDX MIT": "DECLARED_TESTED",
    "LifeMonitor enrollment": "EXTERNAL_VERIFICATION_REQUIRED",
    "WorkflowHub registration": "EXTERNAL_VERIFICATION_REQUIRED",
    "bio.tools scope and acceptance": "EXTERNAL_VERIFICATION_REQUIRED",
    "Workflow Run RO-Crate": "CONDITIONAL_NOT_YET_CLAIMED",
    "Clinical or biological scientific validity": "NOT_APPLICABLE",
    "CodeMeta 3.0": "DECLARED_STRUCTURAL_PREFLIGHT",
    "JSONL graph projection + SQLite FTS5": "CI_EXECUTABLE_LOCAL",
    "Independent research software inspection": "STATIC_PREFLIGHT_ONLY",
    "Independent protein FASTA / PDB bioinformatics data QA": "CI_EXECUTABLE_LOCAL",
    "bio.tools registration": "EXTERNAL_VERIFICATION_REQUIRED",
    "LifeMonitor GitHub App": "INSTALLED_BOT_PR_EXTERNALLY_OBSERVED"
  },
  "global_lifemonitor_defaults": "BRANCH_TAG_TRACKING_REGISTRY_UPDATES_AND_VISIBILITY_UNSPECIFIED_IN_REPOSITORY_CONFIG",
  "notes": "The root-level LifeMonitor config uses the documented filename and only sets repository name and issue checks; structural checks and CI are not independent external registration or scientific validity",
  "bio_tool": "bio_tool/cli.py",
  "lifemonitor_repository_config": {
    "path": "lifemonitor.yaml",
    "issue_checks": "ENABLED_FOR_THIS_REPOSITORY",
    "push_overrides": "NONE",
    "visibility_override": "NONE",
    "external_recognition": "REQUIRES_POST_CHANGE_VERIFICATION"
  }
}
