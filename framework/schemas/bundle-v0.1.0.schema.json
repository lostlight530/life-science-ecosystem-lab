{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lostlight530/life-science-ecosystem-lab/blob/main/framework/schemas/bundle-v0.1.0.schema.json",
  "title": "LS Framework standalone software-engineering contract v0.1.0",
  "description": "Project-owned schema, not an institutional standard. Cross-reference validation, accessible byte identity, lineage cycle tests, authority and method-domain checks are enforced by the Framework engine, not JSON Schema alone",
  "type": "object",
  "properties": {
    "kind": {
      "const": "LS_RSE_INTEROP_BUNDLE"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "scope": {
      "const": "LIFE_SCIENCES"
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "domain": {
            "enum": [
              "genomics",
              "transcriptomics",
              "proteomics",
              "structural_biology",
              "cell_biology",
              "microscopy",
              "metabolomics",
              "microbiome",
              "ecology_life_sciences",
              "life_sciences_integrative"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "domain",
          "kind",
          "sha256",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "method": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true
          },
          "supported_domains": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "enum": [
                "genomics",
                "transcriptomics",
                "proteomics",
                "structural_biology",
                "cell_biology",
                "microscopy",
                "metabolomics",
                "microbiome",
                "ecology_life_sciences",
                "life_sciences_integrative"
              ]
            }
          },
          "outcome": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "NOT_RUN",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "id",
          "method",
          "inputs",
          "outputs",
          "supported_domains",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true
          },
          "authority": {
            "const": "PROPOSAL_ONLY"
          }
        },
        "required": [
          "id",
          "statement",
          "evidence",
          "authority"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "schema_version",
    "scope",
    "assets",
    "steps",
    "claims"
  ],
  "additionalProperties": false
}
